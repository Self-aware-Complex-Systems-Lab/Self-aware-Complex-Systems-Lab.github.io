---
import Base from '../layouts/Base.astro';
import PageHeader from '../components/PageHeader.astro';
import news from '../data/news.json';
const fmt = (d: string) => new Date(d + 'T00:00:00').toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' });
---
<Base title="News" description="Papers, awards, defenses, talks and events from the Self-aware Complex Systems Laboratory.">
  <PageHeader title="News" kicker="Lab updates" />
  <ol class="space-y-4">
    {news.map((n) => (
      <li class="bg-white border border-line rounded-lg p-5 grid grid-cols-1 sm:grid-cols-[9rem_minmax(0,1fr)] gap-3">
        <div class="text-sm text-muted"><time datetime={n.date}>{fmt(n.date)}</time><span class="mt-1 block text-xs font-semibold uppercase tracking-wide text-cardinal">{n.type}</span></div>
        <div>
          <h2 class="text-lg font-bold leading-snug">{n.link ? <a href={n.link} rel="noopener" class="no-underline hover:underline text-ink">{n.title}</a> : n.title}</h2>
          {n.body && <p class="mt-1 text-[0.95rem]">{n.body}</p>}
          {n.image && <img src={n.image} alt="" loading="lazy" class="mt-3 rounded max-h-72 w-auto" />}
        </div>
      </li>
    ))}
  </ol>
</Base>
