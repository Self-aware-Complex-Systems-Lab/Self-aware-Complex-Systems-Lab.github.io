---
import Base from '../layouts/Base.astro';
import PageHeader from '../components/PageHeader.astro';
import page from '../data/page-principal-investigator.json';
import assets from '../data/assets.json';
import { SITE, withLinks } from '../lib/site';
import videos from '../data/talks-video.json';
import recentFunding from '../data/funding-recent.json';
import grantAnn from '../data/grant-announcements.json';
import awardsData from '../data/awards.json';
import { buildVita } from '../lib/vita';
const vitaNow = buildVita();
// Honors: the full list from the (auto-updated) vita, with announcement links where we have them.
const words = (t: string) => new Set(t.toLowerCase().match(/[a-z0-9]{3,}/g) ?? []);
const linkFor = (h: string) => awardsData.awards.find((a) => { if (!a.url) return false; const A = words(a.text), H = words(h); let n = 0; H.forEach((w) => A.has(w) && n++); return n / Math.min(A.size, H.size) >= 0.6; })?.url ?? null;
const honors = vitaNow.honors.map((h) => ({ text: h, url: linkFor(h) }));
// Keep the biography's headline numbers in step with the vita.
const roundDown = (n: number, step: number) => Math.floor(n / step) * step;
const liveBio = (t: string) => t.replace(/more than \d+ peer-reviewed publications/, `more than ${roundDown(vitaNow.facts.publications, 50)} peer-reviewed publications`).replace(/about \$[\d.]+M (in )?research funding/, (_m, inn) => `about $${vitaNow.facts.fundingM.toFixed(1)}M ${inn ?? ''}research funding`);
const announcement = (t: string) => grantAnn.grants.find((g) => t.startsWith(g.grantPrefix))?.url;

const sec = (h: string) => page.find((s) => s.heading === h)?.items ?? [];
const profile = sec('Personal Profile');
const idx = (t: string) => profile.findIndex((i) => i.text === t);
const contact = profile.slice(1, idx('Dr. Soumik Sarkar'));
const after = profile.slice(idx('Dr. Soumik Sarkar') + 1);
const titles = after.filter((i) => i.text.length < 140 && !/^(Ph\.D|M\.S|B\.E)/.test(i.text));
const degrees = after.filter((i) => /^(Ph\.D|M\.S|B\.E)/.test(i.text));
const bio = after.filter((i) => i.text.length >= 140);
// The original splits one grant's amount onto its own paragraph; join for display only (see migration/content-review.md).
const funding = sec('Research Funding').reduce<string[]>((acc, i) => {
  if (/^\(\$/.test(i.text) && acc.length) acc[acc.length - 1] += ' ' + i.text; else acc.push(i.text);
  return acc;
}, []);
const teaching = sec('Teaching');
const photo = assets.pi.find((p) => p.manifestId.startsWith('principal-investigator'))!;
const talks = sec('Invited Talks');
---
<Base title="Prof. Soumik Sarkar"
  description="Prof. Soumik Sarkar, Iowa State University — Professor of Mechanical Engineering, Director of the Translational AI Center (TrAC) and director of the Self-aware Complex Systems Laboratory (SCSLab). Biography, research funding, teaching and invited talks."
  jsonLd={{ '@context': 'https://schema.org', '@type': 'Person', name: 'Soumik Sarkar', honorificPrefix: 'Prof.', jobTitle: 'Professor of Mechanical Engineering',
    url: SITE.url + '/principal-investigator/', image: new URL(photo.src, SITE.url).href, email: 'mailto:soumiks@iastate.edu',
    worksFor: { '@type': 'CollegeOrUniversity', name: SITE.university, url: 'https://www.iastate.edu/' },
    affiliation: [{ '@type': 'ResearchOrganization', name: SITE.name, url: SITE.url + '/' }, { '@type': 'Organization', name: 'Translational AI Center (TrAC)', url: 'https://trac-ai.iastate.edu/' }],
    sameAs: ['https://www.me.iastate.edu/faculty/profile/soumiks/', 'https://scholar.google.com/citations?user=-rmRjqIAAAAJ', 'https://orcid.org/0000-0002-6775-9199'] }}>
  <PageHeader title="Prof. Soumik Sarkar, Iowa State University" kicker="Principal Investigator · Personal Profile" />
  <section class="grid md:grid-cols-[18rem_minmax(0,1fr)] gap-8">
    <div>
      <img src={photo.src} alt="Photo of Dr. Soumik Sarkar" width="414" height="407" class="w-full rounded-lg border border-line" data-person-photo="Dr. Soumik Sarkar" />
      <div class="mt-4 bg-white border border-line rounded-lg p-4 text-sm">
        <h2 class="font-bold text-base mb-2">Contact Information</h2>
        <ul class="space-y-1">{contact.map((i) => <li set:html={withLinks(i.text, i.links)} />)}</ul>
      </div>
      <a href="/cv/Soumik_Sarkar_CV.pdf" class="mt-4 flex items-center justify-center gap-2 rounded bg-cardinal px-4 py-2.5 text-white no-underline hover:bg-cardinal-dark hover:text-white font-semibold">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M12 3v12m0 0l-4-4m4 4l4-4M5 21h14"/></svg>
        Download CV (PDF)
      </a>
      <a href="/cv/" class="mt-2 block text-center text-sm">View CV online</a>
    </div>
    <div>
      <h2 class="text-2xl font-bold">Dr. Soumik Sarkar</h2>
      <ul class="mt-2 text-muted space-y-0.5">{titles.map((i) => <li set:html={withLinks(i.text, i.links)} />)}</ul>
      <h3 class="mt-6 font-bold">Education</h3>
      <ul class="mt-1 space-y-0.5">{degrees.map((i) => <li>{i.text}</li>)}</ul>
      <div class="prose-lab mt-6">{bio.map((i) => <p>{liveBio(i.text)}</p>)}</div>
    </div>
  </section>

  <section class="mt-14" id="awards">
    <h2 class="text-2xl font-bold mb-5">Honors &amp; Awards</h2>
    <ul class="grid grid-cols-1 md:grid-cols-2 gap-3">
      {honors.map((a) => (
        <li class="bg-white border border-line rounded-lg p-4 text-[0.95rem] border-l-4 border-l-gold">
          {a.text}{a.url && <> <a href={a.url} rel="noopener" class="whitespace-nowrap text-sm">Announcement →</a></>}
        </li>
      ))}
    </ul>
  </section>

  <section class="mt-14" id="funding">
    <h2 class="text-2xl font-bold mb-5">Research Funding</h2>
    <h3 class="font-bold text-lg mb-3">Recent grants</h3>
    <ol class="space-y-3 mb-8">{recentFunding.grants.map((g) => <li class="bg-white border border-line rounded-lg p-4 text-[0.95rem]">{g.text}</li>)}</ol>
    <h3 class="font-bold text-lg mb-3">Earlier grants</h3>
    <ol class="space-y-3">{funding.map((f) => {
      const a = announcement(f);
      return <li class="bg-white border border-line rounded-lg p-4 text-[0.95rem]">{f}{a && <> <a href={a} rel="noopener" class="whitespace-nowrap text-sm">Announcement →</a></>}</li>;
    })}</ol>
  </section>

  <section class="mt-14 grid lg:grid-cols-2 gap-10">
    <div id="teaching">
      <h2 class="text-2xl font-bold">Teaching</h2>
      <p class="mt-3">{teaching[0]?.text}</p>
      <ul class="mt-3 list-disc pl-5 space-y-1">{teaching.slice(1).map((i) => <li>{i.text}</li>)}</ul>
    </div>
    <div id="outreach">
      <h2 class="text-2xl font-bold">Outreach</h2>
      <ul class="mt-3 list-disc pl-5 space-y-2">{sec('Outreach').map((i) => <li set:html={withLinks(i.text, i.links)} />)}</ul>
    </div>
  </section>

  <section class="mt-14" id="videos">
    <h2 class="text-2xl font-bold">Talks &amp; Videos</h2>
    <ul class="mt-5 grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-5">
      {videos.map((v) => (
        <li class="bg-white border border-line rounded-lg overflow-hidden flex flex-col">
          <a href={v.url} rel="noopener" class="block no-underline" aria-label={`Watch: ${v.title}`}>
            {v.thumb
              ? <img src={v.thumb} alt="" loading="lazy" width="480" height="360" class="w-full aspect-video object-cover" />
              : <div class="w-full aspect-video bg-black text-white flex items-center justify-center font-serif text-lg px-4 text-center">{v.event}</div>}
          </a>
          <div class="p-4 flex-1">
            <a href={v.url} rel="noopener" class="font-semibold leading-snug no-underline hover:underline">{v.title}</a>
            <p class="text-sm text-muted mt-1">{v.event} · {new Date(v.date + 'T00:00:00').toLocaleDateString('en-US', { year: 'numeric', month: 'short' })}{v.duration ? ` · ${v.duration}` : ''}</p>
            {v.note && <p class="text-xs text-muted mt-1">{v.note}</p>}
          </div>
        </li>
      ))}
    </ul>
  </section>

  <section class="mt-14" id="talks">
    <h2 class="text-2xl font-bold">Invited Talks <span class="text-base font-normal text-muted">({talks.length})</span></h2>
    <ul class="mt-4 divide-y divide-line bg-white border border-line rounded-lg">
      {talks.map((i) => <li class="px-4 py-2.5 text-[0.95rem]">{i.text}</li>)}
    </ul>
  </section>
</Base>
