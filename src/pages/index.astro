---
import Base from '../layouts/Base.astro';
import home from '../data/page-home.json';
import assets from '../data/assets.json';
import { people } from '../lib/people';
import { publications, pubByKey } from '../lib/publications';
import featuredData from '../data/featured-publications.json';
import news from '../data/news.json';
import { SITE, CURRENT_CATEGORIES, ALUMNI_CATEGORIES, withLinks } from '../lib/site';

const about = home.find((s) => s.heading === 'About Us')!;
const [intro, servesAs] = about.items.map((i) => i.text);
const roles = about.items.slice(2);
const hero = assets.gallery.find((g) => g.manifestId === 'home#002') ?? assets.gallery[0];
const nCurrent = people.filter((p) => CURRENT_CATEGORIES.includes(p.category ?? '')).length;
const nAlumni = people.filter((p) => ALUMNI_CATEGORIES.includes(p.category ?? '')).length;
// Recently accepted / published work: journal and conference papers only, newest first.
const when = (p: (typeof publications)[number]) => p.date ?? `${p.year ?? 0}-00-00`;
const featured = featuredData.featured.map((f) => ({ ...pubByKey.get(f.key)!, badge: f.badge, displayTitle: (f as { displayTitle?: string }).displayTitle }));
const authorsShort = (a: string | null) => { const l = (a ?? '').split(/\s+and\s+/).map((x) => x.trim()).filter(Boolean); return l.length > 4 ? `${l.slice(0, 3).join(', ')}, et al.` : l.join(', '); };
const latest = publications.filter((p) => p.category !== 'preprints' && p.year)
  .sort((a, b) => when(b).localeCompare(when(a))).slice(0, 6);
---
<Base title="SCSLab"
  description="The Self-aware Complex Systems Laboratory (SCSLab) at Iowa State University, led by Prof. Soumik Sarkar: machine learning for autonomous perception and decision-making in complex cyber-physical systems."
  jsonLd={{ '@context': 'https://schema.org', '@type': 'ResearchOrganization', name: SITE.name, alternateName: SITE.short, url: SITE.url + '/',
    logo: new URL(assets.logo, SITE.url).href, parentOrganization: { '@type': 'CollegeOrUniversity', name: SITE.university, url: 'https://www.iastate.edu/' },
    founder: { '@type': 'Person', name: 'Soumik Sarkar', url: SITE.url + '/principal-investigator/' } }}>
  <section class="grid lg:grid-cols-5 gap-8 items-center">
    <div class="lg:col-span-2">
      <p class="text-sm font-semibold uppercase tracking-wider text-cardinal">Iowa State University</p>
      <h1 class="text-4xl sm:text-5xl font-bold leading-tight mt-2">Self-aware Complex Systems Laboratory</h1>
      <div class="mt-4 h-1 w-16 bg-gold rounded"></div>
      <p class="mt-4 font-semibold">Self-aware Complex Systems Laboratory (SCSLab), Iowa State University, led by Prof. <a href="/principal-investigator/">Soumik Sarkar</a>.</p>
      <p class="mt-3 text-lg text-muted">Machine learning for autonomous perception and decision-making in complex cyber-physical systems.</p>
      <div class="mt-6 flex flex-wrap gap-3">
        <a href="/research/" class="rounded bg-cardinal px-4 py-2 text-white no-underline hover:bg-cardinal-dark hover:text-white">Our research</a>
        <a href="/publications/" class="rounded border border-cardinal px-4 py-2 no-underline">Publications</a>
      </div>
    </div>
    <figure class="lg:col-span-3">
      <img src={hero.src} alt="SCSLab members, group photo" width={hero.size[0]} height={hero.size[1]} class="w-full rounded-lg shadow-sm" />
    </figure>
  </section>

  <section class="mt-14 grid lg:grid-cols-3 gap-10">
    <div class="lg:col-span-2">
      <h2 class="text-2xl font-bold">About Us</h2>
      <p class="mt-3 leading-relaxed">{intro}</p>
    </div>
    <div class="bg-white border border-line rounded-lg p-5">
      <h2 class="text-lg font-bold">{servesAs.replace(/\s+$/, '')}</h2>
      <ul class="mt-2 space-y-2 text-[0.95rem]">{roles.map((r) => <li class="border-l-2 border-gold pl-3" set:html={withLinks(r.text, r.links)} />)}</ul>
    </div>
  </section>

  <section class="mt-14 grid sm:grid-cols-3 gap-4 text-center">
    <a href="/people/" class="bg-white border border-line rounded-lg p-5 no-underline text-ink hover:border-cardinal"><span class="block text-3xl font-bold text-cardinal">{nCurrent}</span>members listed</a>
    <a href="/alumni/" class="bg-white border border-line rounded-lg p-5 no-underline text-ink hover:border-cardinal"><span class="block text-3xl font-bold text-cardinal">{nAlumni}</span>alumni listed</a>
    <a href="/publications/" class="bg-white border border-line rounded-lg p-5 no-underline text-ink hover:border-cardinal"><span class="block text-3xl font-bold text-cardinal">{publications.length}</span>publications</a>
  </section>

  <section class="mt-14" aria-labelledby="news">
    <div class="flex items-baseline justify-between gap-4">
      <h2 id="news" class="text-2xl font-bold">Latest news</h2>
      <a href="/news/" class="text-sm">All news →</a>
    </div>
    <ul class="mt-5 grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-4">
      {news.slice(0, 4).map((n) => (
        <li class="bg-white border border-line rounded-lg p-4 flex flex-col">
          <span class="text-xs font-semibold uppercase tracking-wide text-cardinal">{n.type}</span>
          <a href={n.link ?? '/news/'} rel="noopener" class="mt-1 font-semibold leading-snug no-underline hover:underline text-ink">{n.title}</a>
          <span class="mt-auto pt-2 text-xs text-muted">{new Date(n.date + 'T00:00:00').toLocaleDateString('en-US', { month: 'short', year: 'numeric' })}</span>
        </li>
      ))}
    </ul>
  </section>

  <section class="mt-14" aria-labelledby="featured">
    <div class="flex items-baseline justify-between gap-4">
      <h2 id="featured" class="text-2xl font-bold">Featured publications</h2>
      <a href="/publications/" class="text-sm">All publications →</a>
    </div>
    <ul class="mt-5 grid grid-cols-1 md:grid-cols-2 gap-4">
      {featured.map((p) => (
        <li class="bg-white border border-line rounded-lg p-5 flex flex-col">
          <span class="self-start rounded bg-cardinal text-white text-xs font-semibold px-2 py-0.5">{p.badge}{p.year ? ` · ${p.year}` : ''}</span>
          <a href={p.url ?? '/publications/'} rel="noopener" class="mt-2 font-semibold leading-snug no-underline hover:underline">{p.displayTitle ?? p.title}</a>
          <p class="mt-1 text-sm text-muted">{authorsShort(p.authors)}</p>
          {(p.projectPage || p.code) && (
            <p class="mt-2 flex gap-3 text-sm">
              {p.projectPage && <a href={p.projectPage} rel="noopener">Project page</a>}
              {p.code && <a href={p.code} rel="noopener">Code</a>}
            </p>
          )}
        </li>
      ))}
    </ul>
  </section>

  <section class="mt-14" aria-labelledby="sponsors">
    <h2 id="sponsors" class="text-2xl font-bold">Sponsors</h2>
    <ul class="mt-5 grid grid-cols-2 sm:grid-cols-4 lg:grid-cols-7 gap-4 items-center">
      {assets.sponsors.map((s) => (
        <li class="bg-white border border-line rounded-lg p-3 h-24 flex items-center justify-center">
          <img src={s.src} alt={s.name} title={s.name} loading="lazy" class="max-h-16 max-w-full object-contain" data-sponsor={s.name} />
        </li>
      ))}
      <li class="bg-white border border-line rounded-lg p-3 h-24 flex items-center justify-center text-center font-serif font-bold leading-tight text-cardinal">Regents<br />Innovation<br />Funds</li>
    </ul>
  </section>
</Base>
