---
// Prof. Sarkar's FACULTY VITA in Iowa State's format, regenerated on every build (see src/lib/vita.ts).
// scripts/render-cv-pdf.mjs prints this page to /cv/Soumik_Sarkar_CV.pdf.
import { buildVita, type Sub, type Block } from '../lib/vita';

const { meta, sections } = buildVita();
const roman = (id: string) => id.split('-')[0];
type Numbered = { block: Block; labels: string[] };
// Number items: continuous across a subsection's blocks unless the original restarted; honour original quirks.
function numberBlocks(sub: Sub): Numbered[] {
  let n = 0;
  return sub.blocks.map((b) => {
    if (sub.numberingContinues === false) n = 0;
    if (b.style === 'bullets' || b.style === 'plain') return { block: b, labels: [] };   // only numbered lists advance the counter
    const labels = b.items.map((_, i) => b.numbers?.[i] ?? String(++n));
    if (b.numbers) n = Math.max(n, ...b.numbers.map(Number).filter((x) => !Number.isNaN(x)));
    return { block: b, labels };
  });
}
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>Soumik Sarkar · Faculty Vita</title>
  <meta name="description" content="Faculty vita of Prof. Soumik Sarkar, Iowa State University — updated automatically." />
  <style>
    * { box-sizing: border-box; }
    body { margin: 0; background: #fff; color: #000; font: 12pt/1.25 "Times New Roman", Tinos, "Liberation Serif", Times, serif; }
    main { max-width: 6.5in; margin: 0 auto; padding: 0.5in 0.15in 1in; }
    .title { text-align: center; font-size: 12pt; border-bottom: 1.5px solid #000; padding-bottom: 2px; margin: 0 0 14px; font-weight: normal; letter-spacing: 0.02em; }
    .meta p { margin: 0; }
    h2 { font-size: 12pt; font-weight: normal; margin: 18px 0 10px; }
    h3 { font-size: 12pt; font-weight: normal; margin: 14px 0 10px 0.3in; }
    h4 { font-size: 12pt; font-weight: normal; margin: 12px 0 10px 0.6in; }
    .bh { margin: 10px 0 8px 0.6in; }
    .bh.i { font-style: italic; }
    ul.plain { list-style: none; margin: 0 0 0 0.6in; padding: 0; }
    ul.plain li { margin: 0; }
    ul.bul { margin: 0 0 0 0.6in; padding-left: 0.25in; text-align: justify; }
    ul.bul li { margin: 0 0 10px; }
    ol.num { list-style: none; margin: 0 0 0 0.6in; padding: 0; }
    ol.num li { display: grid; grid-template-columns: 0.32in 1fr; margin: 0 0 10px; break-inside: avoid; text-align: justify; }
    ol.num li .n { text-align: left; }
    .grant { margin: 0 0 12px 0.6in; break-inside: avoid; }
    .grant p { margin: 0; display: grid; grid-template-columns: 1.35in 1fr; }
    .grant p.gn { display: block; }
    a { color: #00e; }
    u { text-decoration-thickness: 1px; }
    .bar { font-family: system-ui, sans-serif; font-size: 10pt; margin-bottom: 16px; display: flex; gap: 12px; align-items: center; }
    .bar a { background: #9e1b32; color: #fff; padding: 6px 12px; border-radius: 4px; text-decoration: none; font-weight: 600; }
    @media print { .bar { display: none; } main { padding: 0; } }
    @page { size: Letter; margin: 1in 1in 0.9in; }
  </style>
</head>
<body>
<main>
  <div class="bar"><a href="/cv/Soumik_Sarkar_CV.pdf">Download PDF</a><span>Updated automatically · {meta.date}</span></div>
  <h1 class="title">{meta.title}</h1>
  <div class="meta">
    <p>Date: {meta.date}</p>
    <p>Name: {meta.name}</p>
    <p>Department: {meta.department}</p>
    <p>Current Rank: {meta.rank}</p>
  </div>

  {sections.map((s) => (
    <section>
      <h2>{roman(s.id)}. {s.title}</h2>
      {s.subsections.map((sub) => (
        <>
          <h3>{sub.letter}. {sub.title}</h3>
          {[sub, ...(sub.children ?? [])].map((part, pi) => (
            <>
              {pi > 0 && <h4>{part.number}. {part.title}</h4>}
              {numberBlocks(part).map(({ block: b, labels }) => (
                <>
                  {b.heading && <p class:list={['bh', /^(Graduated|Percentage)/.test(b.heading) && 'i']}>{b.heading}</p>}
                  {b.grants && b.grants.map((g) => (
                    <div class="grant">
                      <p class="gn">{g.n}:</p>
                      <p><span>Investigators:</span><span>{g.investigators}</span></p>
                      <p><span>Title:</span><span>{g.title}</span></p>
                      <p><span>Funding agency:</span><span>{g.agency}</span></p>
                      <p><span>Dates:</span><span>{g.dates}</span></p>
                      <p><span>Total fund:</span><span>{g.total}</span></p>
                      <p><span>Role on project:</span><span>{g.role}</span></p>
                    </div>
                  ))}
                  {b.items.length > 0 && (
                    b.style === 'bullets' ? <ul class="bul">{b.items.map((it) => <li set:html={it} />)}</ul>
                    : b.style === 'plain' ? <ul class="plain">{b.items.map((it) => <li set:html={it} />)}</ul>
                    : <ol class="num">{b.items.map((it, i) => <li><span class="n">{labels[i]}.</span><span set:html={it} /></li>)}</ol>
                  )}
                </>
              ))}
            </>
          ))}
        </>
      ))}
    </section>
  ))}
</main>
</body>
</html>
