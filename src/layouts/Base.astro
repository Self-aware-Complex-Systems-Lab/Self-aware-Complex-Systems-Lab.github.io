---
import '@fontsource/source-sans-3/400.css';
import '@fontsource/source-sans-3/600.css';
import '@fontsource/source-sans-3/700.css';
import '@fontsource-variable/source-serif-4/opsz.css';
import '../styles/global.css';
import { SITE, NAV } from '../lib/site';
import assets from '../data/assets.json';

interface Props { title: string; description?: string; noindex?: boolean; jsonLd?: object; }
const { title, noindex = false, jsonLd, description = `${SITE.name} at ${SITE.university}, directed by Prof. Soumik Sarkar.` } = Astro.props;
const path = Astro.url.pathname.replace(/\/?$/, '/');
// Descriptive, unique titles for search: "Research | <lab> – Iowa State University"; home leads with the lab name.
const fullTitle = title === SITE.short ? `${SITE.name} (${SITE.short}) | ${SITE.university}` : `${title} | ${SITE.name} – ${SITE.university}`;
const canonical = new URL(path, SITE.url).href;
// Link-preview image for social shares: the lab group photo (1280×693, ~1.9:1 like the 1200×630 card size).
const shareImage = new URL('/assets/gallery/lab-group-photo-storefront.jpg', SITE.url).href;
const isActive = (href: string) => (href === '/' ? path === '/' : path.startsWith(href));
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    {noindex ? <meta name="robots" content="noindex" /> : <link rel="canonical" href={canonical} />}
    {SITE.googleVerification && <meta name="google-site-verification" content={SITE.googleVerification} />}
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content="en_US" />
    <meta property="og:image" content={shareImage} />
    <meta property="og:image:width" content="1280" />
    <meta property="og:image:height" content="693" />
    <meta property="og:image:alt" content={`${SITE.name} members, group photo`} />
    {/* X/Twitter card (LinkedIn, Facebook, Slack, WhatsApp and Teams read the og: tags above) */}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={shareImage} />
    <meta name="twitter:image:alt" content={`${SITE.name} members, group photo`} />
    <meta name="author" content={SITE.name} />
    <meta name="keywords" content="Self-aware Complex Systems Laboratory, SCSLab, Iowa State University, Soumik Sarkar, machine learning, cyber-physical systems, AI for agriculture, scientific machine learning, autonomous systems" />
    <meta name="theme-color" content="#000000" />
    <link rel="apple-touch-icon" href={assets.logo} />
    {jsonLd && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}
    <link rel="icon" type="image/png" href={assets.logo} />
  </head>
  <body class="min-h-screen flex flex-col">
    <a href="#main" class="sr-only focus:not-sr-only focus:absolute focus:top-2 focus:left-2 bg-white px-3 py-2 rounded z-50">Skip to main content</a>
    <header class="bg-black text-white sticky top-0 z-40">
      <div class="mx-auto max-w-6xl 2xl:max-w-7xl px-4 sm:px-6 flex items-center justify-between gap-4 h-16">
        <a href="/" class="flex items-center gap-3 no-underline text-white hover:text-white shrink-0" aria-label="SCSLab home">
          <img src={assets.logo} alt="" width="505" height="360" class="h-9 w-auto" />
          <span class="text-xl font-semibold tracking-wide">{SITE.short}</span>
        </a>
        <nav id="site-nav" aria-label="Primary"
             class="hidden absolute inset-x-0 top-16 bg-black border-t border-white/10 lg:static lg:block lg:border-0">
          <ul class="flex flex-col lg:flex-row lg:items-center px-4 pb-3 lg:p-0 lg:gap-1">
            {NAV.map((n) => (
              <li>
                <a href={n.href} aria-current={isActive(n.href) ? 'page' : undefined}
                   class:list={['block px-3 py-3 lg:py-2 text-[0.95rem] no-underline rounded lg:rounded-none lg:border-b-2',
                     isActive(n.href) ? 'text-white font-semibold lg:border-gold' : 'text-gray-300 hover:text-white lg:border-transparent']}>
                  {n.label}
                </a>
              </li>
            ))}
          </ul>
        </nav>
        <button id="nav-toggle" class="lg:hidden inline-flex items-center gap-2 rounded border border-white/30 px-3 py-2 text-sm text-white" aria-expanded="false" aria-controls="site-nav">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M3 6h18M3 12h18M3 18h18"/></svg>
          Menu
        </button>
      </div>
    </header>
    <main id="main" class="flex-1 mx-auto w-full max-w-6xl 2xl:max-w-7xl px-4 sm:px-6 py-8 sm:py-12">
      <slot />
    </main>
    <footer class="bg-black text-gray-300 text-sm">
      <div class="mx-auto max-w-6xl 2xl:max-w-7xl px-4 sm:px-6 py-8 grid gap-4 sm:grid-cols-2">
        <div>
          <p class="font-semibold text-white">{SITE.name}</p>
          <p>Department of Mechanical Engineering · {SITE.university} · Ames, IA 50011</p>
        </div>
        <div class="sm:text-right">
          <p><a class="text-gold" href="mailto:soumiks@iastate.edu">soumiks@iastate.edu</a> · 515-294-5212 · <a class="text-gold" href="https://github.com/SCSLabISU">GitHub</a></p>
          <p>&copy; {new Date().getFullYear()} {SITE.name} · <a class="text-gold" href="/contribute/">Lab members: contribute</a></p>
        </div>
      </div>
    </footer>
    <script>
      const b = document.getElementById('nav-toggle');
      const n = document.getElementById('site-nav');
      b?.addEventListener('click', () => {
        const open = b.getAttribute('aria-expanded') === 'true';
        b.setAttribute('aria-expanded', String(!open));
        n?.classList.toggle('hidden', open);
      });
    </script>
  </body>
</html>
