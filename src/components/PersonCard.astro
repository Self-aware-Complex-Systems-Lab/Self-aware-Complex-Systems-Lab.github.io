---
import { slug, linkify } from '../lib/site';
import corrections from '../data/link-corrections.json';
import web from '../data/people-web-links.json';
import profiles from '../data/people-profiles.json';
import personPubs from '../data/people-publications.json';
import { pubByKey } from '../lib/publications';

const LABEL: Record<string, string> = {
  homepage: 'Homepage', scholar: 'Google Scholar', github: 'GitHub', 'faculty-page': 'Faculty page', cv: 'CV',
  linkedin: 'LinkedIn', x: 'X', orcid: 'ORCID', researchgate: 'ResearchGate', other: 'Profile',
};
interface Person {
  name: string; category: string | null; contactEmailAsListed: string | null;
  lines: string[]; links: { label: string; href: string }[]; photo: string | null; photoManifestId: string | null;
}
interface Profile {
  name: string; headline: string | null; education: string[]; affiliation?: string[]; bio: string[];
  researchInterests: string | null; joined: string | null; currentPosition: string | null; project: string | null;
}
interface Props { person: Person; compact?: boolean; }
const { person: p, compact = false } = Astro.props;

// Proofread, organized profile (src/data/people-profiles.json); falls back to the source lines.
const pr = (profiles as Record<string, Profile>)[p.name];
const short = p.lines.filter((l) => l.length < 140);
const long = p.lines.filter((l) => l.length >= 140);
const displayName = pr?.name ?? p.name;
// The current role is shown in the 'Now' chip, so drop a trailing '· now …' from the headline.
const headline = pr?.headline ? (pr.currentPosition ? pr.headline.replace(/\s*[·|;,]\s*(now|currently)\b.*$/i, '') : pr.headline) : null;
const education = pr ? [...pr.education, ...(pr.affiliation ?? [])] : short;
const bio = pr ? pr.bio : long;
const webMeta = web as unknown as { links: Record<string, { type: string; url: string; label?: string }[]>; interests: Record<string, string> };
const interests = pr?.researchInterests ?? webMeta.interests[p.name] ?? null;

const hidden = new Set(corrections.hide.filter((h) => h.person === p.name).map((h) => h.href));
const relabel = new Map(((corrections as { relabel?: { person: string; label: string; newLabel: string }[] }).relabel ?? [])
  .filter((r) => r.person === p.name).map((r) => [r.label, r.newLabel]));
const links = p.links.filter((l) => !hidden.has(l.href)).map((l) => ({ ...l, label: relabel.get(l.label) ?? l.label }));
const norm = (u: string) => u.replace(/^https?:\/\/(www\.|[a-z]{2}\.)?/, '').replace(/[/?#].*hl=en$/, '').replace(/\/$/, '');
const known = new Set(links.map((l) => norm(l.href)));
const found = (webMeta.links[p.name] ?? []).filter((l) => !known.has(norm(l.url)));
const email = p.contactEmailAsListed && p.contactEmailAsListed !== 'N/A' ? p.contactEmailAsListed : null;
const myPubs = ((personPubs as Record<string, string[]>)[p.name] ?? []).map((k) => pubByKey.get(k)!).filter(Boolean);
const shortVenue = (v: string | null) => (v ?? '').replace(/,\s*(Vol\.|pp\.|\d).*$/, '').replace(/\s*\(\d{4}\)\s*$/, '');
const hasLinks = !!email || links.length > 0 || found.length > 0;
---
<article id={slug(p.name)} class="person bg-white border border-line rounded-lg overflow-hidden flex flex-col sm:flex-row scroll-mt-20"
  data-name={p.name} data-photo-id={p.photoManifestId}>
  {p.photo && (
    <div class:list={['shrink-0 self-start w-full', compact ? 'sm:w-36' : 'sm:w-52']}>
      <img src={p.photo} alt={`Photo of ${displayName}`} loading="lazy" decoding="async"
           class="w-full aspect-square object-cover object-top" data-person-photo={p.name} />
    </div>
  )}
  <div class="p-4 sm:p-5 min-w-0 flex-1">
    <h3 class="text-lg font-bold text-ink">{displayName}</h3>
    {headline && <p class="text-[0.95rem] font-semibold text-cardinal">{headline}</p>}
    {(pr?.joined || pr?.currentPosition) && (
      <p class="mt-2 flex flex-wrap gap-2 text-xs">
        {pr.joined && <span class="rounded-full bg-paper border border-line px-2.5 py-0.5">Joined {pr.joined}</span>}
        {pr.currentPosition && <span class="rounded-full bg-gold/25 px-2.5 py-0.5">Now: {pr.currentPosition}</span>}
      </p>
    )}
    {education.length > 0 && (
      <ul class="mt-3 text-sm text-muted space-y-0.5">
        {education.map((l) => <li set:html={linkify(l)} />)}
      </ul>
    )}
    {bio.length > 0 && (
      compact
        ? <details class="mt-3 text-[0.95rem]"><summary class="cursor-pointer text-cardinal text-sm font-semibold">About</summary>
            <div class="prose-lab mt-2">{bio.map((l) => <p set:html={linkify(l)} />)}</div></details>
        : <div class="prose-lab mt-3 text-[0.95rem]">{bio.map((l) => <p set:html={linkify(l)} />)}</div>
    )}
    {interests && <p class="mt-2 text-sm"><span class="font-semibold">Research interests:</span> {interests}</p>}
    {pr?.project && <p class="mt-2 text-sm"><span class="font-semibold">Project:</span> {pr.project}</p>}
    {myPubs.length > 0 && (
      <div class="mt-3 text-sm">
        <p class="font-semibold">Publications with the lab ({myPubs.length})</p>
        <ul class="mt-1 space-y-1">
          {myPubs.slice(0, compact ? 2 : 3).map((x) => (
            <li class="leading-snug"><a href={x.url ?? '#'} rel="noopener" class="no-underline hover:underline">{x.title}</a>
              <span class="text-muted"> — {shortVenue(x.venue)}{x.year ? ` (${x.year})` : ''}</span></li>
          ))}
        </ul>
        {myPubs.length > (compact ? 2 : 3) && (
          <details class="mt-1">
            <summary class="cursor-pointer text-cardinal font-semibold">Show all {myPubs.length}</summary>
            <ul class="mt-1 space-y-1">
              {myPubs.slice(compact ? 2 : 3).map((x) => (
                <li class="leading-snug"><a href={x.url ?? '#'} rel="noopener" class="no-underline hover:underline">{x.title}</a>
                  <span class="text-muted"> — {shortVenue(x.venue)}{x.year ? ` (${x.year})` : ''}</span></li>
              ))}
            </ul>
          </details>
        )}
      </div>
    )}
    {hasLinks && (
      <p class="mt-3 text-sm flex flex-wrap gap-x-4 gap-y-1">
        {email && <span class="text-muted">{email}</span>}
        {links.map((l) => <a href={l.href} rel="noopener">{l.label}</a>)}
        {found.map((l) => <a href={l.url} rel="noopener" data-web-link>{l.type === 'other' && l.label ? l.label : (LABEL[l.type] ?? 'Profile')}</a>)}
      </p>
    )}
  </div>
</article>
