---
interface Props { title: string; kicker?: string; }
const { title, kicker } = Astro.props;
---
<div class="mb-8">
  {kicker && <p class="text-sm font-semibold uppercase tracking-wider text-cardinal">{kicker}</p>}
  <h1 class="text-3xl sm:text-4xl font-bold text-ink">{title}</h1>
  <div class="mt-3 h-1 w-16 bg-gold rounded"></div>
  <slot />
</div>
